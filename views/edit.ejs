<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Student</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
  <div class="h-full w-full p-10">
     <a href="/read" class="px-4 py-3 text-white bg-blue-600 rounded-lg">Back</a>
      
    <div class="max-w-lg mx-auto bg-white p-8 mt-10 rounded-lg shadow-lg">
      <h2 class="text-2xl font-bold text-center text-yellow-600 mb-6">Edit Student</h2>
    <form action="/update/<%= Useredit._id %>" method="post" class="space-y-4">
      <input type="text" name="name" value="<%= Useredit.name %>" placeholder="Enter New Name" class="w-full p-3 border rounded-lg" required>
      <input type="email" name="email" value="<%= Useredit.email %>" placeholder="Enter New Email" class="w-full p-3 border rounded-lg" required>
      <input type="text" name="class" value="<%= Useredit.class %>" placeholder="Enter Class" class="w-full p-3 border rounded-lg" required>
      <!-- <input type="file" name="image" value="<%= Useredit.image %>" class="w-full p-3 border rounded-lg bg-gray-50"> -->
      <button type="submit" class="w-full bg-yellow-500 text-white py-3 rounded-lg hover:bg-yellow-600">Update Student</button>
    </form>
  </div>
</div>
</body>
</html>






