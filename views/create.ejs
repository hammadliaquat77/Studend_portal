<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
  <meta charset="UTF-8">
  <title>Add Student</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100">
   <div class="h-full w-full p-10 ">
     <a href="/" class="px-4 py-3 text-white bg-blue-600 rounded-lg">Back</a>
     
     <div class="max-w-lg mx-auto bg-white p-8 mt-10 rounded-lg shadow-lg">
    <h2 class="text-2xl font-bold text-center text-blue-600 mb-6">Add Student</h2>
    <form action="/create" method="post" enctype="multipart/form-data" class="space-y-4">
      <input type="text" name="name" placeholder="Enter Name" class="w-full p-3 border rounded-lg" required>
      <input type="email" name="email" placeholder="Enter Email" class="w-full p-3 border rounded-lg" required>
      <input type="text" name="class" placeholder="Enter Class" class="w-full p-3 border rounded-lg" required>
      <input type="file" name="image" class="w-full p-3 border rounded-lg bg-gray-50">
      <button type="submit" class="w-full bg-blue-500 text-white py-3 rounded-lg hover:bg-blue-600">Add Student</button>
    </form>
  </div>
</div>
</body>
</html>
